# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
# For local MongoDB: mongodb://127.0.0.1:27017/skillswap
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillswap?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/skillswap

# JWT Authentication Secret
JWT_SECRET=skillswap_jwt_super_secret_key_2026_peer_exchange

# JWT Expiration
JWT_EXPIRE=30d
